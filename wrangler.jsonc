{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-brief-free",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-brief-free",
      "database_id": "0092ccbc-b11f-4683-955d-9438f0d16ac9"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "UI_VERSION": "aab814a72c1a",
    "READER_USERNAME": "reader"
  },
  "observability": {
    "enabled": false
  }
}
